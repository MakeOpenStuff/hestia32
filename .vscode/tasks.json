{
    "version": "2.0.0",
    "tasks": [
			{
				"label": "ESP-IDF: Build",
				"type": "shell",
				"command": "source ~/esp/esp-idf-v5.5/export.sh && idf.py build",
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"problemMatcher": [
					"$gcc"
				],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": false
				}
			},
			{
				"label": "ESP-IDF: Flash",
				"type": "shell",
				"command": "source ~/esp/esp-idf-v5.5/export.sh && idf.py -p ${input:serialPort} flash",
				"group": "none",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": false
				}
			},
			{
				"label": "ESP-IDF: Monitor",
				"type": "shell",
				"command": "source ~/esp/esp-idf-v5.5/export.sh && idf.py -p ${input:serialPort} monitor",
				"group": "none",
				"isBackground": true,
				"problemMatcher": {
					"pattern": {
						"regexp": "^(.*)$",
						"file": 1
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".*",
						"endsPattern": ".*"
					}
				},
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "dedicated",
					"showReuseMessage": false,
					"clear": false
				}
			},
			{
				"label": "ESP-IDF: Build and Flash",
				"dependsOrder": "sequence",
				"dependsOn": [
					"ESP-IDF: Build",
					"ESP-IDF: Flash"
				],
				"group": "none",
				"problemMatcher": []
			},
			{
				"label": "ESP-IDF: Build, Flash and Monitor",
				"dependsOrder": "sequence",
				"dependsOn": [
					"ESP-IDF: Build",
					"ESP-IDF: Flash",
					"ESP-IDF: Monitor"
				],
				"group": "none",
				"problemMatcher": []
			},
			{
				"label": "ESP-IDF: Clean",
				"type": "shell",
				"command": "source ~/esp/esp-idf-v5.5/export.sh && idf.py fullclean",
				"group": "none",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": false
				}
			},
			{
				"label": "ESP-IDF: Menuconfig",
				"type": "shell",
				"command": "source ~/esp/esp-idf-v5.5/export.sh && idf.py menuconfig",
				"group": "none",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "dedicated",
					"showReuseMessage": false,
					"clear": false
				}
			},
			{
				"label": "ESP-IDF: Flash and Monitor",
				"type": "shell",
				"command": "source ~/esp/esp-idf-v5.5/export.sh && idf.py -p ${input:serialPort} flash monitor",
				"group": "none",
				"isBackground": true,
				"problemMatcher": {
					"pattern": {
						"regexp": "^(.*)$",
						"file": 1
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".*",
						"endsPattern": ".*"
					}
				},
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "dedicated",
					"showReuseMessage": false,
					"clear": false
				}
			}
		],
    "inputs": [
        {
            "id": "serialPort",
            "type": "promptString",
            "description": "Enter serial port (e.g., /dev/ttyUSB0)",
            "default": "/dev/ttyUSB0"
        }
    ]
}
