// HTTP GET handler for config page
static esp_err_t config_get_handler(httpd_req_t *req)
{
    wifi_config_data_t config = {0};
    wifi_prov_get_config(&config);

    char response[2048];
    snprintf(response, sizeof(response), config_html,
             config.server_url[0] ? config.server_url : OTA_SERVER_URL,
             config.node_name[0] ? config.node_name : "ESP32-Node");

    httpd_resp_set_type(req, "text/html");
    return httpd_resp_send(req, response, strlen(response));
}

// Captive portal detection handlers for various platforms
static esp_err_t captive_portal_handler(httpd_req_t *req)
{
    // Redirect all captive portal detection requests to our config page
    httpd_resp_set_status(req, "302 Found");
    httpd_resp_set_hdr(req, "Location", "http://192.168.4.1/");
    httpd_resp_send(req, NULL, 0);
    return ESP_OK;
}

// Parse URL-encoded form data
static void parse_form_data(const char *data, wifi_config_data_t *config)
{
    char *buf = strdup(data);
    char *token = strtok(buf, "&");

    while (token != NULL) {
        char *eq = strchr(token, '=');
        if (eq) {
            *eq = '\0';
            char *key = token;
            char *value = eq + 1;

            // URL decode (basic - just handle + and %)
            char decoded[128];
            int j = 0;
            for (int i = 0; value[i] && j < 127; i++) {
                if (value[i] == '+') {
                    decoded[j++] = ' ';
                } else if (value[i] == '%' && value[i+1] && value[i+2]) {
                    char hex[3] = {value[i+1], value[i+2], 0};
                    decoded[j++] = (char)strtol(hex, NULL, 16);
                    i += 2;
                } else {
                    decoded[j++] = value[i];
                }
            }
            decoded[j] = '\0';

            if (strcmp(key, "ssid") == 0) {
                strncpy(config->ssid, decoded, MAX_SSID_LEN - 1);
            } else if (strcmp(key, "password") == 0) {
                strncpy(config->password, decoded, MAX_PASSWORD_LEN - 1);
            } else if (strcmp(key, "server") == 0) {
                strncpy(config->server_url, decoded, MAX_SERVER_URL_LEN - 1);
            } else if (strcmp(key, "node") == 0) {
                strncpy(config->node_name, decoded, MAX_NODE_NAME_LEN - 1);
            }
        }
        token = strtok(NULL, "&");
    }

    free(buf);
    config->provisioned = true;
}

// HTTP POST handler for saving config
static esp_err_t config_post_handler(httpd_req_t *req)
{
    char content[512];
    int ret = httpd_req_recv(req, content, sizeof(content));

    if (ret <= 0) {
        if (ret == HTTPD_SOCK_ERR_TIMEOUT) {
            httpd_resp_send_408(req);
        }
        return ESP_FAIL;
    }

    content[ret] = '\0';

    wifi_config_data_t config = {0};
    parse_form_data(content, &config);

    ESP_LOGI(TAG, "Received config - SSID: %s, Server: %s, Node: %s",
             config.ssid, config.server_url, config.node_name);

    esp_err_t err = wifi_prov_save_config(&config);
    if (err != ESP_OK) {
        httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Failed to save config");
        return ESP_FAIL;
    }

    httpd_resp_set_type(req, "text/html");
    httpd_resp_send(req, success_html, strlen(success_html));

    // Schedule restart after sending response
    vTaskDelay(pdMS_TO_TICKS(100));
    esp_restart();

    return ESP_OK;
}

// Start HTTP server for provisioning
static esp_err_t start_webserver(void)
{
    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
    config.server_port = 80;
    config.lru_purge_enable = true;

    ESP_LOGI(TAG, "Starting HTTP server on port %d", config.server_port);

    if (httpd_start(&server, &config) == ESP_OK) {
        httpd_uri_t config_get = {
            .uri = "/",
            .method = HTTP_GET,
            .handler = config_get_handler,
            .user_ctx = NULL
        };
        httpd_register_uri_handler(server, &config_get);

        httpd_uri_t config_post = {
            .uri = "/save",
            .method = HTTP_POST,
            .handler = config_post_handler,
            .user_ctx = NULL
        };
        httpd_register_uri_handler(server, &config_post);

        return ESP_OK;
    }

    ESP_LOGE(TAG, "Failed to start HTTP server");
    return ESP_FAIL;
}

// Stop HTTP server
static void stop_webserver(void)
{
    if (server) {
        httpd_stop(server);
        server = NULL;
    }
}

esp_err_t wifi_prov_init(void)
{
    esp_err_t ret = nvs_flash_init();
    if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        ret = nvs_flash_init();
    }
    return ret;
}

bool wifi_prov_is_provisioned(void)
{
    nvs_handle_t nvs_handle;
    esp_err_t err = nvs_open(NVS_NAMESPACE, NVS_READONLY, &nvs_handle);

    if (err != ESP_OK) {
        return false;
    }

    uint8_t provisioned = 0;
    err = nvs_get_u8(nvs_handle, "provisioned", &provisioned);
    nvs_close(nvs_handle);

    return (err == ESP_OK && provisioned == 1);
}

esp_err_t wifi_prov_get_config(wifi_config_data_t *config)
{
    if (!config) {
        return ESP_ERR_INVALID_ARG;
    }

    memset(config, 0, sizeof(wifi_config_data_t));

    nvs_handle_t nvs_handle;
    esp_err_t err = nvs_open(NVS_NAMESPACE, NVS_READONLY, &nvs_handle);
    if (err != ESP_OK) {
        return err;
    }

    size_t len;

    len = MAX_SSID_LEN;
    nvs_get_str(nvs_handle, "ssid", config->ssid, &len);

    len = MAX_PASSWORD_LEN;
    nvs_get_str(nvs_handle, "password", config->password, &len);

    len = MAX_SERVER_URL_LEN;
    nvs_get_str(nvs_handle, "server_url", config->server_url, &len);

    len = MAX_NODE_NAME_LEN;
    nvs_get_str(nvs_handle, "node_name", config->node_name, &len);

    uint8_t provisioned = 0;
    nvs_get_u8(nvs_handle, "provisioned", &provisioned);
    config->provisioned = (provisioned == 1);

    nvs_close(nvs_handle);
    return ESP_OK;
}

esp_err_t wifi_prov_save_config(const wifi_config_data_t *config)
{
    if (!config) {
        return ESP_ERR_INVALID_ARG;
    }

    nvs_handle_t nvs_handle;
    esp_err_t err = nvs_open(NVS_NAMESPACE, NVS_READWRITE, &nvs_handle);
    if (err != ESP_OK) {
        return err;
    }

    nvs_set_str(nvs_handle, "ssid", config->ssid);
    nvs_set_str(nvs_handle, "password", config->password);
    nvs_set_str(nvs_handle, "server_url", config->server_url);
    nvs_set_str(nvs_handle, "node_name", config->node_name);
    nvs_set_u8(nvs_handle, "provisioned", config->provisioned ? 1 : 0);

    err = nvs_commit(nvs_handle);
    nvs_close(nvs_handle);

    ESP_LOGI(TAG, "Configuration saved to NVS");
    return err;
}

esp_err_t wifi_prov_reset(void)
{
    nvs_handle_t nvs_handle;
    esp_err_t err = nvs_open(NVS_NAMESPACE, NVS_READWRITE, &nvs_handle);
    if (err != ESP_OK) {
        return err;
    }

    nvs_erase_all(nvs_handle);
    nvs_commit(nvs_handle);
    nvs_close(nvs_handle);

    ESP_LOGI(TAG, "Provisioning reset");
    return ESP_OK;
}

esp_err_t wifi_prov_start_ap(void)
{
    ESP_LOGI(TAG, "Starting provisioning AP mode");

    ESP_ERROR_CHECK(esp_netif_init());
    ESP_ERROR_CHECK(esp_event_loop_create_default());

    ap_netif = esp_netif_create_default_wifi_ap();

    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));

    wifi_config_t wifi_config = {
        .ap = {
            .ssid = PROV_AP_SSID,
            .ssid_len = strlen(PROV_AP_SSID),
            .channel = 1,
            .password = PROV_AP_PASSWORD,
            .max_connection = 4,
            .authmode = WIFI_AUTH_WPA_WPA2_PSK
        },
    };

    if (strlen(PROV_AP_PASSWORD) == 0) {
        wifi_config.ap.authmode = WIFI_AUTH_OPEN;
    }

    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_AP));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_AP, &wifi_config));
    ESP_ERROR_CHECK(esp_wifi_start());

    ESP_LOGI(TAG, "WiFi AP started. SSID: %s, Password: %s", PROV_AP_SSID, PROV_AP_PASSWORD);
    ESP_LOGI(TAG, "Connect to this AP and navigate to http://192.168.4.1");

    start_webserver();

    return ESP_OK;
}

void wifi_prov_stop_ap(void)
{
    stop_webserver();
    esp_wifi_stop();
    if (ap_netif) {
        esp_netif_destroy(ap_netif);
        ap_netif = NULL;
    }
    ESP_LOGI(TAG, "Provisioning AP stopped");
}
